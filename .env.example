# ==============================================================================
# Al-Maktabah (المكتبة) — Environment Configuration Template
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Database Configuration
# ------------------------------------------------------------------------------
# Connection string from MongoDB Atlas Cluster > Connect > Drivers
# Leave blank to run in offline local memory fallback mode.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/al_maktabah?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Administrator Authentication & Cryptographic Keys
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@almaktabah.org
ADMIN_PASSWORD=maktabah1445
# Cryptographic secret used for HMAC-SHA256 session token generation & verification
ADMIN_SECRET_KEY=replace_with_a_secure_random_64_char_hex_secret_in_production

# ------------------------------------------------------------------------------
# 3. Base Site URL & SEO Canonical Target
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://al-maktabah.org

# ------------------------------------------------------------------------------
# 4. Cloudinary High-Speed Edge CDN (Optional — for unlimited direct uploads)
# ------------------------------------------------------------------------------
# When provided, manuscript PDFs and high-res scans upload directly from browser
# to Cloudinary CDN, bypassing serverless function payload limits.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. Google Gemini AI API (Optional — for manuscript OCR & morphological parsing)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
