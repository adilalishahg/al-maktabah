# ==============================================================================
# AL-MAKTABAH DIGITAL ARCHIVE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# MongoDB Connection String (Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/al_maktabah?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/al_maktabah?retryWrites=true&w=majority"

# Cloudinary CDN Credentials (for fast book cover & PDF manuscript asset hosting)
# Get these free from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin Authentication Secret (optional, defaults to maktabah1445)
ADMIN_SECRET="maktabah1445"

# Google Gemini API Key (for semantic research & isnad analysis)
GEMINI_API_KEY=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
